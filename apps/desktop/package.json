{
  "name": "@lmps/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "corepack pnpm run tauri -- dev",
    "build": "corepack pnpm run tauri -- build",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build:frontend": "tsc --noEmit -p frontend/tsconfig.json && vite --config frontend/vite.config.ts build",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "sidecar:sea": "corepack pnpm --filter @lmps/core-service run sidecar:sea"
  },
  "dependencies": {
    "@lmps/i18n": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@lmps/domain": "workspace:*",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "6.4.3"
  }
}